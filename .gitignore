# Lambda build artifacts
iac/lambda.zip

# Dipendenze Python vendored: tieni solo il tuo codice, ignora tutto il resto
# (le dipendenze si reinstallano con: pip install -r requirements.txt -t iac/lambda)
iac/lambda/*
!iac/lambda/handler.py
!iac/lambda/requirements.txt

